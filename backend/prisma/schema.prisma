generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int              @id @default(autoincrement())
  nombre    String
  email     String           @unique
  password  String
  cargo     String           @default("Empleado")
  cuenta    String           @default("Svelte")
  lob       String           @default("E-commerce")
  modalidad String           @default("Remoto")
  rol       String           @default("EMPLEADO")
  creadoEn  DateTime         @default(now())

  sesiones  Sesion[]
  horarios  ControlHorario[]
  equipos   Equipo[]
  tickets     Ticket[]
}

model Sesion {
  id         Int       @id @default(autoincrement())
  usuarioId  Int
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiraEn   DateTime
  revocadaEn DateTime?
  creadoEn   DateTime  @default(now())
}

model ControlHorario {
  id                Int       @id @default(autoincrement())
  usuarioId         Int
  usuario           Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  horaEntrada       DateTime  @default(now())
  horaSalida        DateTime?
  minutosTrabajados Int?
  modalidad         String    @default("Remoto")
  estado            String    @default("EN_JORNADA")
  observacion       String?
  creadoEn          DateTime  @default(now())
}

model Equipo {
  id               Int       @id @default(autoincrement())
  codigoInventario String    @unique
  categoria        String
  marcaModelo      String
  numeroSerie      String    @unique
  estado           String    @default("EN_BODEGA")
  costoCompra      Float?    // <-- NUEVO: Para costear escalar proyectos (BI)
  comentarios      String?   // <-- NUEVO: Para specs, cables nuevos o notas de fichaje
  usuarioId        Int?
  usuario          Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  fechaAsignacion  DateTime?
  creadoEn         DateTime  @default(now())

  historial        HistorialEquipo[]
  tickets          Ticket[]
}

model HistorialEquipo {
  id          Int      @id @default(autoincrement())
  equipoId    Int
  equipo      Equipo   @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  accion      String
  detalle     String
  creadoEn    DateTime @default(now())
} 

model Ticket {
  id          Int      @id @default(autoincrement())
  asunto      String
  descripcion String
  estado      String   @default("ABIERTO") // ABIERTO, EN_PROCESO, RESUELTO
  prioridad   String   @default("MEDIA")   // BAJA, MEDIA, ALTA
  creadoEn    DateTime @default(now())

  // Relaciones
  usuarioId   Int
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  
  equipoId    Int?     // Opcional: por si el fallo es de un equipo específico
  equipo      Equipo?  @relation(fields: [equipoId], references: [id])
}